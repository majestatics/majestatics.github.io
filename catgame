<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cat Coin Adventure</title>
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#101729;color:#fff;font:16px system-ui,sans-serif}.game{width:min(900px,96vw)}header{display:flex;justify-content:space-between;padding:8px 4px}h1{font-size:1.2rem;margin:0}#score{color:#ffe16b;font-weight:bold}canvas{display:block;width:100%;height:auto;border:3px solid white;border-radius:12px;background:#82c9e8}p{color:#d7e3ff;font-size:.9rem}#startScreen{position:fixed;inset:0;display:grid;place-items:center;background:#101729dd}#startScreen button{padding:14px 32px;border:0;border-radius:8px;background:#ffe16b;color:#19233d;font:bold 20px system-ui;cursor:pointer}#results{display:none;position:fixed;inset:0;place-items:center;background:#101729dd}.panel{padding:24px;background:#26334d;border-radius:12px;text-align:center;min-width:300px}#playerName{width:80px;text-transform:uppercase;font-size:20px;text-align:center}#leaderboard{padding:0;list-style:none}
    #touchControls{display:flex;justify-content:center;gap:14px;margin:12px 0}#touchControls button{width:72px;height:58px;border:2px solid #fff;border-radius:12px;background:#26334d;color:#fff;font-size:26px;touch-action:none;user-select:none;-webkit-user-select:none}#touchControls button:active{background:#465b80}
  </style>
</head>
<body>
  <main class="game">
    <header><h1>🐱 INCI HANIMIN MACERALARI</h1><div id="score">Coins: 0</div></header>
    <canvas id="game" width="900" height="500" aria-label="Cat platform game"></canvas>
    <div id="touchControls" aria-label="Touch controls"><button type="button" data-key="a" aria-label="Move left">←</button><button type="button" data-key="w" aria-label="Jump">↑</button><button type="button" data-key="d" aria-label="Move right">→</button></div>
    <p>Move: ← → or A / D · Jump: ↑, W, or Space · Collect all the coins!</p>
  </main>
  <div id="startScreen"><button id="startButton">Start Game</button></div>
  <div id="results"><section class="panel"><h2>Game over! Score: <span id="finalScore"></span></h2><label>Name (max 3 letters): <input id="playerName" maxlength="3" autocomplete="off"></label><button id="saveScore">Save score</button><h3>Leaderboard</h3><ol id="leaderboard"></ol><button id="replayButton">Replay</button></section></div>
  <script>
    const canvas=document.querySelector('#game'),ctx=canvas.getContext('2d');
    const scoreText=document.querySelector('#score'),keys=new Set();
    document.querySelectorAll('#touchControls button').forEach(button=>{const key=button.dataset.key;button.addEventListener('pointerdown',e=>{e.preventDefault();button.setPointerCapture(e.pointerId);keys.add(key)});for(const type of ['pointerup','pointercancel','lostpointercapture'])button.addEventListener(type,()=>keys.delete(key))});
    const platforms=[{x:0,y:460,w:900,h:40}],coins=[];
    const cat={x:160,y:418,w:34,h:42,vx:0,vy:0,ground:false};let score=0,camera=0,ended=false,started=false,nextX=900,lastY=460;
    const records=[];const startScreen=document.querySelector('#startScreen'),results=document.querySelector('#results');
    function startGame(){started=true;startScreen.style.display='none'}
    document.querySelector('#startButton').addEventListener('click',startGame);
    document.querySelector('#replayButton').addEventListener('click',()=>{results.style.display='none';startScreen.style.display='grid';started=false;ended=false;score=0;camera=0;nextX=900;lastY=460;cat.x=160;cat.y=418;cat.vx=0;cat.vy=0;cat.ground=false;platforms.length=0;coins.length=0;platforms.push({x:0,y:460,w:900,h:40});scoreText.textContent='Coins: 0';document.querySelector('#playerName').value='';document.querySelector('#playerName').disabled=false;document.querySelector('#saveScore').disabled=false;document.querySelector('#leaderboard').innerHTML='';generate()});
    addEventListener('keydown',e=>{if(!started&&['enter',' '].includes(e.key.toLowerCase())){e.preventDefault();startGame()}});
    document.querySelector('#saveScore').addEventListener('click',()=>{const name=document.querySelector('#playerName').value.trim().slice(0,3).toUpperCase()||'CAT';records.push({name,score});records.sort((a,b)=>b.score-a.score);document.querySelector('#leaderboard').innerHTML=records.slice(0,5).map(r=>`<li>${r.name} — ${r.score}</li>`).join('');document.querySelector('#playerName').disabled=true;document.querySelector('#saveScore').disabled=true});
    function generate(){while(nextX<camera+1800){const x=nextX+75+Math.random()*65,y=Math.max(260,Math.min(460,lastY+(Math.random()-.5)*120)),w=115+Math.random()*65;platforms.push({x,y,w,h:18});coins.push({x:x+w/2,y:y-35,got:false});nextX=x+w;lastY=y}}
    generate();
    addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(['arrowleft','arrowright','arrowup',' '].includes(k))e.preventDefault();keys.add(k);if(ended&&k==='enter')location.reload()});
    addEventListener('keyup',e=>keys.delete(e.key.toLowerCase()));
    function update(){if(ended||!started)return;const runSpeedMultiplier=1+score*0.05;camera+=2*runSpeedMultiplier;generate();const moveSpeed=3.8*runSpeedMultiplier;cat.vx=((keys.has('arrowright')||keys.has('d'))?moveSpeed:0)-((keys.has('arrowleft')||keys.has('a'))?moveSpeed:0);if((keys.has('arrowup')||keys.has('w')||keys.has(' '))&&cat.ground){cat.vy=-11.5;cat.ground=false}const bottom=cat.y+cat.h;cat.x+=cat.vx;cat.vy+=.55;cat.y+=cat.vy;cat.ground=false;for(const p of platforms)if(cat.vy>=0&&bottom<=p.y&&cat.y+cat.h>=p.y&&cat.x+cat.w>p.x&&cat.x<p.x+p.w){cat.y=p.y-cat.h;cat.vy=0;cat.ground=true}for(const c of coins)if(!c.got&&cat.x<c.x+13&&cat.x+cat.w>c.x-13&&cat.y<c.y+13&&cat.y+cat.h>c.y-13){c.got=true;score++;scoreText.textContent=`Coins: ${score}`}if(cat.y>500||cat.x-camera+cat.w<0||cat.x-camera>900){ended=true;document.querySelector('#finalScore').textContent=score;results.style.display='grid'}while(platforms.length&&platforms[0].x+platforms[0].w<camera-100)platforms.shift();while(coins.length&&coins[0].x<camera-100)coins.shift()}
    function draw(){ctx.clearRect(0,0,900,500);ctx.fillStyle='#82c9e8';ctx.fillRect(0,0,900,500);ctx.fillStyle='rgba(255,255,255,.7)';for(const [x,y] of [[100,75],[390,105],[720,65]]){const sx=((x-camera*.25)%950+950)%950;ctx.beginPath();ctx.arc(sx,y,22,0,7);ctx.arc(sx+25,y-8,28,0,7);ctx.arc(sx+52,y,20,0,7);ctx.fill()}for(const p of platforms){const x=p.x-camera;ctx.fillStyle='#8b5a3c';ctx.fillRect(x,p.y,p.w,p.h);ctx.fillStyle='#45b85a';ctx.fillRect(x,p.y,p.w,6)}for(const c of coins)if(!c.got){const x=c.x-camera;ctx.fillStyle='#ffcb35';ctx.beginPath();ctx.arc(x,c.y,11,0,7);ctx.fill();ctx.strokeStyle='#e69b19';ctx.lineWidth=3;ctx.stroke();ctx.fillStyle='#fff2a1';ctx.fillRect(x-2,c.y-6,3,12)}const x=cat.x-camera;ctx.fillStyle='#fff';ctx.strokeStyle='#111';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(x+17,cat.y+25,16,17,0,0,7);ctx.fill();ctx.stroke();ctx.beginPath();ctx.moveTo(x+3,cat.y+15);ctx.lineTo(x+5,cat.y);ctx.lineTo(x+15,cat.y+8);ctx.closePath();ctx.fill();ctx.stroke();ctx.beginPath();ctx.moveTo(x+19,cat.y+8);ctx.lineTo(x+30,cat.y);ctx.lineTo(x+32,cat.y+17);ctx.closePath();ctx.fill();ctx.stroke();ctx.fillStyle='#26334d';ctx.beginPath();ctx.arc(x+11,cat.y+20,1.5,0,7);ctx.arc(x+24,cat.y+20,1.5,0,7);ctx.fill();ctx.fillStyle='#f5b1a2';ctx.beginPath();ctx.arc(x+18,cat.y+26,2,0,7);ctx.fill();if(ended){ctx.fillStyle='rgba(25,35,61,.8)';ctx.fillRect(0,0,900,500);ctx.textAlign='center';ctx.fillStyle='#ffe16b';ctx.font='bold 40px system-ui';ctx.fillText('Game over!',450,235);ctx.fillStyle='white';ctx.font='20px system-ui';ctx.fillText('Press Enter to try again',450,275)}}
    function loop(){update();draw();requestAnimationFrame(loop)}loop();
  </script>
</body>
</html>
